# Compose
COMPOSE_PROJECT_NAME=predictionlab

# Application
SERVICE_NAME=ai-polyphite-backend
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
READINESS_TIMEOUT_SECONDS=2.0
AI_POLYPHITE_ENABLED_PROVIDERS=manifold
AI_POLYPHITE_COLLECTOR_INTERVAL_SECONDS=60
AI_POLYPHITE_PROVIDER_INTERVALS_SECONDS=manifold=60
AI_POLYPHITE_COLLECTOR_RUN_IMMEDIATELY=true
AI_POLYPHITE_COLLECTOR_PAGE_SIZE=300
AI_POLYPHITE_COLLECTOR_MAX_PAGES_PER_RUN=1
AI_POLYPHITE_MANIFOLD_SYNC_MODE=recent
AI_POLYPHITE_REPLAY_DATASET_DIRECTORY=backend/datasets/replay
AI_POLYPHITE_CODE_VERSION=balanced-short-horizon-v2
AI_POLYPHITE_ENABLE_MANUAL_PREDICTION_RUNS=false
AI_POLYPHITE_ENABLE_MANUAL_PAPER_TRADING=false
AI_POLYPHITE_ENABLE_MANUAL_PAPER_OVERRIDES=false
AI_POLYPHITE_REPLAY_PREDICTION_INTERVAL_HOURS=24
PREDICTION_MINIMUM_CONFIDENCE=0.40
PREDICTION_MAXIMUM_DISAGREEMENT=0.30
PREDICTION_MAXIMUM_OBSERVATION_AGE_SECONDS=172800
PREDICTION_WEAK_EDGE=0.03
PREDICTION_MODERATE_EDGE=0.08
PREDICTION_STRONG_EDGE=0.15
PREDICTION_REQUIRE_RESOLUTION_AT=true
PREDICTION_MINIMUM_RESOLUTION_HORIZON_SECONDS=300
PREDICTION_MAXIMUM_RESOLUTION_HORIZON_SECONDS=1209600
PREDICTION_MAXIMUM_CANDIDATES_PER_BATCH=1

# PostgreSQL - local development defaults only
POSTGRES_DB=predictionlab
POSTGRES_USER=predictionlab
POSTGRES_PASSWORD=predictionlab_local_only
POSTGRES_PORT=5432
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
DATABASE_URL=postgresql+psycopg://predictionlab:predictionlab_local_only@127.0.0.1:5432/predictionlab
CONTAINER_DATABASE_URL=postgresql+psycopg://predictionlab:predictionlab_local_only@postgres:5432/predictionlab

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CONTAINER_REDIS_URL=redis://redis:6379/0
REDIS_STREAM_PREFIX=predictionlab

# Ollama is started by Docker Compose and remains behind the ModelBackend port
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
CONTAINER_OLLAMA_BASE_URL=http://ollama:11434
PREDICTION_MODEL_BACKEND=hybrid
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_REASONING_TEMPERATURE=0.30
OLLAMA_SKEPTIC_TEMPERATURE=0.45

# Paper trading research defaults - simulated units only
PAPER_CURRENCY_UNIT=MANA_SIMULATED
PAPER_INITIAL_BALANCE=100.00
PAPER_ENTRY_MINIMUM_EDGE=0.02
PAPER_ENTRY_MINIMUM_CONFIDENCE=0.40
PAPER_MAXIMUM_DATA_AGE_SECONDS=172800
PAPER_ALLOW_YES=true
PAPER_ALLOW_NO=true
PAPER_MINIMUM_STAKE=0.50
PAPER_MAXIMUM_STAKE=10.00
PAPER_SIZING_POLICY=confidence_adjusted
PAPER_BASE_EQUITY_FRACTION=0.01
PAPER_MAXIMUM_MARKET_FRACTION=0.02
PAPER_MAXIMUM_CATEGORY_FRACTION=0.15
PAPER_MAXIMUM_TOTAL_EXPOSURE_FRACTION=0.50
PAPER_DISAGREEMENT_REDUCTION=0.50
PAPER_LOW_LIQUIDITY_REDUCTION=0.50
PAPER_STALE_DATA_REDUCTION=0.50
PAPER_LOW_LIQUIDITY_THRESHOLD=25
PAPER_SIZING_STALE_AFTER_SECONDS=86400
PAPER_COST_MODEL=conservative
PAPER_PERCENTAGE_FEE=0.005
PAPER_FIXED_FEE=0
PAPER_SLIPPAGE_PROBABILITY_POINTS=0.005
PAPER_LOW_LIQUIDITY_PENALTY_POINTS=0.005
PAPER_STALE_OBSERVATION_PENALTY_POINTS=0.005
PAPER_EVIDENCE_PRELIMINARY_TRADES=10
PAPER_EVIDENCE_OBSERVATION_TRADES=30
PAPER_EVIDENCE_EXPANSION_TRADES=100
PAPER_EVIDENCE_MAXIMUM_CONCENTRATION=0.25
AI_POLYPHITE_PAPER_VALIDATION_INTERVAL_SECONDS=60
AI_POLYPHITE_PAPER_VALIDATION_RUN_IMMEDIATELY=true
AI_POLYPHITE_PAPER_VALIDATION_PORTFOLIO_NAME=Autonomous Manifold paper validation
AI_POLYPHITE_PAPER_VALIDATION_RANDOM_SEED=17
AI_POLYPHITE_PAPER_VALIDATION_PROVIDER_CODES=manifold
AI_POLYPHITE_PAPER_VALIDATION_ONLY_NEW_OBSERVATIONS=true
AI_POLYPHITE_EXPERIMENTAL_CAMPAIGN_ENABLED=false
AI_POLYPHITE_EXPERIMENTAL_MIN_NET_EDGE=0.015
