# Compose
COMPOSE_PROJECT_NAME=predictionlab

# Application
SERVICE_NAME=ai-polyphite-backend
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
READINESS_TIMEOUT_SECONDS=2.0
AI_POLYPHITE_ENABLED_PROVIDERS=mock
AI_POLYPHITE_COLLECTOR_INTERVAL_SECONDS=300
AI_POLYPHITE_PROVIDER_INTERVALS_SECONDS=mock=300,manifold=600
AI_POLYPHITE_COLLECTOR_RUN_IMMEDIATELY=true
AI_POLYPHITE_REPLAY_DATASET_DIRECTORY=backend/datasets/replay
AI_POLYPHITE_CODE_VERSION=

# PostgreSQL - local development defaults only
POSTGRES_DB=predictionlab
POSTGRES_USER=predictionlab
POSTGRES_PASSWORD=predictionlab_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://predictionlab:predictionlab_local_only@127.0.0.1:5432/predictionlab
CONTAINER_DATABASE_URL=postgresql+psycopg://predictionlab:predictionlab_local_only@postgres:5432/predictionlab

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CONTAINER_REDIS_URL=redis://redis:6379/0
REDIS_STREAM_PREFIX=predictionlab

# Ollama runs on the host during the initial local phase
OLLAMA_BASE_URL=http://localhost:11434
CONTAINER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Paper trading defaults - no real trading configuration is supported
PAPER_INITIAL_BALANCE=100.00
PAPER_DEFAULT_STAKE=1.00
PAPER_MAX_OPEN_POSITIONS=50
PAPER_MAX_EXPOSURE_RATIO=0.50
